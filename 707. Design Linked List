class MyLinkedList {
private:
    struct Node {
        int val;
        Node* next;
        Node(int x, Node* nxt = nullptr) : val(x), next(nxt) {}
    };

    Node* dummy;
    int size;

public:
    MyLinkedList() {
        dummy = new Node(0);
        size = 0;
    }

    int get(int index) {
        if (index < 0 || index >= size) {
            return -1;
        }
        Node* curr = dummy->next;
        for (int i = 0; i < index; ++i) {
            curr = curr->next;
        }
        return curr->val;
    }

    void addAtHead(int val) {
        addAtIndex(0, val);
    }

    void addAtTail(int val) {
        addAtIndex(size, val);
    }

    void addAtIndex(int index, int val) {
        if (index < 0 || index > size) {
            return;
        }
        Node* prev = dummy;
        for (int i = 0; i < index; ++i) {
            prev = prev->next;
        }
        prev->next = new Node(val, prev->next);
        ++size;
    }

    void deleteAtIndex(int index) {
        if (index < 0 || index >= size) {
            return;
        }
        Node* prev = dummy;
        for (int i = 0; i < index; ++i) {
            prev = prev->next;
        }
        Node* target = prev->next;
        prev->next = target->next;
        delete target;
        --size;
    }

    ~MyLinkedList() {
        Node* curr = dummy;
        while (curr != nullptr) {
            Node* nxt = curr->next;
            delete curr;
            curr = nxt;
        }
    }
};

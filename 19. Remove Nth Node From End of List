/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode dummy(0, head);
        ListNode* slow = &dummy;
        ListNode* fast = &dummy;

        // Advance fast n + 1 steps so slow stops right before the target node
        for (int i = 0; i <= n; ++i) {
            fast = fast->next;
        }

        // Move both pointers until fast reaches nullptr
        while (fast != nullptr) {
            slow = slow->next;
            fast = fast->next;
        }

        // Unlink and delete the nth node from the end
        ListNode* target = slow->next;
        slow->next = target->next;
        delete target;

        return dummy.next;
    }
};
